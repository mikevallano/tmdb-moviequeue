<% content_for(:title, "Discover") %>

<h1>Discover</h1>

<div class="suggestions" data-controller="suggestions">
  <% if @results %>
    <%# Collapse the form into a summary of what was asked, so the results are front and center %>
    <details class="suggestions__form suggestions__collapsible">
      <summary>
        <span class="suggestions__summary"><%= [("Like #{@list.name}" if @list), (%("#{@query.truncate(80)}") if @query)].compact.join(' · ') %></span>
        <span class="suggestions__change">Get more suggestions</span>
      </summary>
      <%= render 'suggestions/form' %>
    </details>
  <% else %>
    <div class="suggestions__form">
      <%= render 'suggestions/form' %>
    </div>
  <% end %>

  <div class="suggestions__loading" role="status" aria-live="polite">
    <div class="suggestions__spinner"></div>
    <h2 data-suggestions-target="message"></h2>
    <p>Grab some snacks. Takes about 10 seconds.</p>
  </div>

  <div class="suggestions__results">
    <% if @results&.not_found_message.present? %>
      <h2>Hmm. <%= @results.not_found_message %></h2>
    <% end %>

    <% if @results&.movies.present? %>
      <%= render partial: 'movies/movie_partial_loop', locals: { movies: @results.movies } %>
    <% end %>
  </div>
</div>

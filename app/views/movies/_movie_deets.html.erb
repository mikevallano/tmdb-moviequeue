  <div class="media-flex">
    <div class="watch-info">
      <div class="image-screenings-providers-container">
        <%= link_to image_for(movie), link_to_movie(movie), data: { turbo: false } %>
        <div class="screenings-providers-container">
          <%= render 'movies/screenings', movie: movie %>
          <%= render "shared/streaming_service_providers", streaming_service_providers: movie.streaming_service_providers(current_user), search_title: movie.title %>
        </div>
      </div>
    </div>

    <div class="movie-details">
      <%= render 'movies/stats_cast_overview', movie: movie, is_modal: is_modal %>

      <div class='movie-interactions mt-10'>
        <%= render 'movies/tags_lists_last_watched', movie: movie %>
      </div>

      <div class="mt-10">
        <%= render "movies/movie_trailer", movie: movie %>
      </div>

      <% if current_user&.admin? && !is_modal %>
        <div class="mt-10">
          <p class=""> Does the movie data seem out-of date?</p>
          <%= link_to "Refresh API data", movie_path(movie),
              method: :patch,
              id: "update_movie_link_movie_show",
              data: { turbo_method: :patch, turbo_confirm: "Refresh movie data from TMDB?" },
              class: "btn btn-secondary mt-10" %>
        </div>
      <% end %>
    </div>
  </div>
